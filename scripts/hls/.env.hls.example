# Copy this file to `.env.hls` (same folder) and fill it in. `.env.hls` is never committed.
VYBEKART_API_URL=https://vybekart-backend.onrender.com
VYBEKART_ADMIN_EMAIL=
VYBEKART_ADMIN_PASSWORD=
# Only needed when ffmpeg / ffprobe are not on PATH, e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
FFPROBE_PATH=
# Temporary files (deleted after each archive). Needs ~2x the size of the biggest archive.
HLS_WORK_DIR=
